{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/fixtures/**/*.jsonl"]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "error",
        "noDefaultExport": "error",
        "noEnum": "error"
      }
    },
    "domains": {
      "react": "none"
    }
  },
  "overrides": [
    {
      "includes": ["*.config.ts", "*.config.js"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {},
                "patterns": [
                  {
                    "group": ["react-native", "react-native-*", "node:*"],
                    "message": "OpenPour never performs I/O or uses platform APIs (ADR 0017). Bluetooth belongs to the consuming app."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["harness/**", "!harness/**/*.test.ts", "!harness/test/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {},
                "patterns": [
                  {
                    "group": ["**/src/**"],
                    "message": "The harness uses OpenPour like any consumer: import openpour, openpour/acaia or openpour/replay."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["harness/web/**", "!harness/web/**/*.test.ts", "!harness/web/test/**"],
      "linter": {
        "domains": {
          "react": "recommended"
        }
      }
    },
    {
      "includes": ["harness/runner/**", "!harness/runner/**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {},
                "patterns": [
                  {
                    "group": ["**/src/**"],
                    "message": "The harness uses OpenPour like any consumer: import openpour, openpour/acaia or openpour/replay."
                  },
                  {
                    "group": ["react", "react-dom", "react/*", "react-dom/*"],
                    "message": "The runner is shared with the Node harness, so it stays free of React and the DOM."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
