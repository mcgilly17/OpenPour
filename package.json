{
  "name": "openpour",
  "version": "0.0.0",
  "description": "One API for Bluetooth coffee scales.",
  "keywords": [
    "coffee",
    "scale",
    "bluetooth",
    "ble",
    "acaia",
    "espresso",
    "pour-over"
  ],
  "homepage": "https://github.com/mcgilly17/OpenPour#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcgilly17/OpenPour.git"
  },
  "bugs": "https://github.com/mcgilly17/OpenPour/issues",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.9.0",
  "exports": {
    ".": "./dist/index.js",
    "./acaia": "./dist/drivers/acaia/index.js",
    "./replay": "./dist/replay/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "harness": "node scripts/harness.ts",
    "typecheck": "tsc && tsc -p harness && tsc -p harness/web && tsc -p scripts",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "test": "vitest run --exclude '.claude/**'",
    "validate": "pnpm lint && pnpm build && pnpm typecheck && pnpm test",
    "release": "semantic-release",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-bluetooth": "0.0.21",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "clsx": "2.1.1",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "fast-check": "4.10.2",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "lucide-react": "1.59.0",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semantic-release": "25.0.9",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tsdown": "0.23.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
